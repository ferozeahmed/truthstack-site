RESEND_API_KEY=re_your_api_key

# Optional: public site URL used for metadata (defaults to the Vercel URL)
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Optional. Where contact messages are delivered (default: the Google Group).
# Until a domain is verified in Resend, set this to your Resend account email.
# CONTACT_TO_EMAIL=you@example.com
# Optional. Sender address; needs a domain verified in Resend.
# CONTACT_FROM_EMAIL=Truthstack <contact@your-domain.com>
